# The GitHub Pages workflow publishes from dist/, so it is generated output
# and is not committed. The build is reproducible from content/ and src/.
dist/

# Dependencies — there are none at runtime, but this keeps the rule explicit.
node_modules/
package-lock.json

# Local environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
npm-debug.log*
yarn-error.log*
*.log
